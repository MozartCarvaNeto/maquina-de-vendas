# backend/.env.example

PORT=3333
NODE_ENV=production

# Supabase / Postgres.
# Supabase > botão "Connect" (topo do painel) > copie a string e troque [YOUR-PASSWORD] pela senha do banco.
# Use "Direct connection" (porta 5432). Se o seu servidor não tiver IPv6 e der erro de conexão,
# use "Session pooler" (também porta 5432). Evite "Transaction pooler" (porta 6543): ele quebra as migrations.
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# Endereço PÚBLICO do sistema (com https, sem barra no final). É usado nos links de abertura/clique/descadastro
# dos e-mails e para a Twilio alcançar os áudios e avisos das ligações robô.
# Em produção: https://app.suaempresa.com.br   |   Em teste local: o endereço https do ngrok.
BACKEND_PUBLIC_URL=https://app.suaempresa.com.br

# JWT
JWT_SECRET=troque_por_uma_string_aleatoria_de_64_caracteres
JWT_EXPIRES_IN=7d

# Criptografia dos valores salvos em Setting (chave de 32 bytes em hex = 64 caracteres 0-9 a-f)
SETTINGS_ENCRYPTION_KEY=troque_por_64_caracteres_hexadecimais

# Endereço do site (mesmo valor do BACKEND_PUBLIC_URL quando o backend serve o frontend)
FRONTEND_URL=https://app.suaempresa.com.br

# ---------------------------------------------------------------------------
# CONTROLE DE ACESSO (venda do sistema)
# ---------------------------------------------------------------------------
# E-mail(s) do ADMINISTRADOR DA PLATAFORMA (você). Quem estiver aqui vê o menu
# "Administração" e nunca é bloqueado. Para criar esse usuário: npm run admin:create
# Vários e-mails: separe por vírgula.
SUPERADMIN_EMAILS=seu@email.com

# O que acontece quando alguém clica em "Criar conta" na tela de login:
#   approval = (recomendado) a pessoa se cadastra, mas só entra depois que VOCÊ aprovar
#   closed   = cadastro público desligado (você cria as contas no painel)
#   open     = libera na hora (use TRIAL_DAYS para dar um período de teste)
REGISTRATION_MODE=approval

# Dias de teste grátis (só vale com REGISTRATION_MODE=open). 0 = sem teste.
TRIAL_DAYS=0

# Dias de tolerância depois do vencimento antes de bloquear de verdade. 0 = bloqueia no dia seguinte.
GRACE_DAYS=0

# ---------------------------------------------------------------------------
# E-MAIL DO SISTEMA (recuperação de senha). Sem isto, "Esqueci minha senha" só
# funciona para quem já configurou e-mail em Configurações.
# Exemplo com Gmail (use uma "senha de app" de 16 letras, NÃO a senha normal):
# ---------------------------------------------------------------------------
SYSTEM_SMTP_HOST=smtp.gmail.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=seu-email@gmail.com
SYSTEM_SMTP_PASS=sua-senha-de-app
SYSTEM_MAIL_FROM=Máquina de Vendas <seu-email@gmail.com>

# Nome do sistema e contato mostrado na tela de login/recuperação (WhatsApp, e-mail...)
APP_NAME=Máquina de Vendas
SUPPORT_CONTACT=suporte@seudominio.com.br

# Quantos "porteiros" (Nginx/Caddy) existem na frente do sistema. 1 é o correto no guia.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# COBRANÇA AUTOMÁTICA (Asaas) — deixe em branco para desligar
# ---------------------------------------------------------------------------
ASAAS_API_KEY=
# sandbox = teste (ninguém é cobrado de verdade) | production = valendo
ASAAS_ENV=sandbox
# Senha inventada por você (32+ letras/números). A MESMA vai no cadastro do webhook no Asaas.
ASAAS_WEBHOOK_TOKEN=
# true = quem acabou de se cadastrar e PAGA é liberado sozinho
AUTO_ACTIVATE_ON_PAYMENT=true

# OBS: NÃO coloque aqui chaves de Twilio, Evolution API, etc.
# Elas são cadastradas dentro do app, na tela Configurações > Integrações,
# e ficam salvas (criptografadas) na tabela "settings" do banco.
