# Copie para .env e preencha. NUNCA publique o arquivo .env (git, zip, e-mail).

# Domínio que aponta para o seu servidor (ex.: nfe.minhaloja.com.br)
DOMINIO=nfe.exemplo.com.br

# Usuário inicial (criado só se ainda não existir nenhum usuário). Senha com 10+ caracteres.
ADMIN_EMAIL=voce@exemplo.com.br
ADMIN_PASSWORD=troque-por-uma-senha-longa

# Chave que protege a sessão e a senha do certificado. Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Guarde uma cópia: se perdê-la, será preciso reenviar o certificado.
SECRET_KEY=

# Opcional: cadeia de certificados ICP-Brasil (PEM) caso a conexão com a SEFAZ falhe por TLS
# SEFAZ_CA_BUNDLE=/data/cadeia-icp-brasil.pem
# SEFAZ_TIMEOUT=60
